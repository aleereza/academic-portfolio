# Copy this file to .deploy-ubc.env if you want fewer password prompts.
# .deploy-ubc.env is gitignored. Keep it chmod 600.
#
# Plaintext passwords are convenient but not very safe. Prefer leaving these
# blank unless you are comfortable with local-account risk on this machine.

# Server and VPN details. Keep real values in .deploy-ubc.env, not in git.
UBC_DEPLOY_REMOTE_USER=
UBC_DEPLOY_REMOTE_HOST=
UBC_DEPLOY_REMOTE_DIR=
UBC_DEPLOY_VPN_HOST=
UBC_DEPLOY_VPN_USER=

# Backup the current remote site before uploading a new build.
UBC_DEPLOY_BACKUP=1
UBC_DEPLOY_BACKUP_DIR=.deploy-backups

# Used by sshpass for rsync/ssh. If blank, SSH/SFTP prompts interactively.
UBC_SSH_PASSWORD=

# Dedicated SSH key for UBC deploys. The deploy script uses this automatically
# if the file exists.
UBC_SSH_KEY=

# Used by openconnect --passwd-on-stdin. If blank, openconnect prompts.
UBC_VPN_PASSWORD=

# Set to 1 to skip the final "type deploy" confirmation.
DEPLOY_CONFIRM=0

# Set to 0 if you have already connected to the VPN yourself.
AUTO_VPN=1
